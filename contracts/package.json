{
  "name": "proofpay-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "ProofPay escrow, payment token and CRE receiver contracts",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:all": "hardhat run scripts/deploy-all.js --network localhost",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:receiver": "hardhat run scripts/deploy-receiver.js --network localhost",
    "authorize:receiver": "hardhat run scripts/authorize-receiver.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "1.1.0",
    "chai": "4.5.0",
    "dotenv": "16.4.7",
    "ethers": "6.17.0",
    "hardhat": "2.29.1"
  }
}
