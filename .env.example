# ProofPay Root Environment Variables Reference
# Individual services maintain dedicated .env configurations:
# - Frontend: frontend/.env.example
# - Backend: backend/.env.example

NODE_ENV=development
PORT=5001
CORS_ORIGIN=*

# Local Hardhat node
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
ESCROW_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
PUSD_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Mock shipment tracking (Phase 3)
SHIPMENT_DATA_FILE=./data/shipments.json
SHIPMENT_CHAIN_TIMEOUT_MS=5000
SHIPMENT_API_BASE_URL=http://localhost:5001/api/shipments
SHIPMENT_SIMULATOR_TOKEN=
SHIPMENT_ALLOW_REMOTE_MUTATIONS=false

# PostgreSQL is not used in Phase 3.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=proofpay
# DB_USER=postgres
# DB_PASSWORD=postgres
